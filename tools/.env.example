# Jenkins Configuration untuk publish_trexo.py
# Copy file ini ke .env dan sesuaikan dengan konfigurasi Anda

# URL Jenkins (ganti dengan IP VPS Anda)
JENKINS_URL=http://your-vps-ip:8080

# Username Jenkins
JENKINS_USER=admin

# API Token Jenkins
# Cara dapatkan token:
# 1. Login ke Jenkins (http://your-vps:8080)
# 2. Klik nama user di pojok kanan atas → Configure
# 3. Scroll ke API Token → Add new Token
# 4. Beri nama (misal: "laptop-token") → Generate
# 5. Copy token yang muncul
JENKINS_TOKEN=your-api-token-here
