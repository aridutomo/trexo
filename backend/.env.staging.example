# Copy to .env.staging and replace <MYSQL_ROOT_PASSWORD> with the real value.
# Targets the shared mysql-server container's STAGING database (trexo_stg).
# switch-db.sh then copies .env.staging -> .env.local for `go run`.
GO_ENV=staging
RUN_MIGRATIONS=true
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
DSN=root:<MYSQL_ROOT_PASSWORD>@tcp(127.0.0.1:3306)/trexo_stg?parseTime=true&loc=UTC&charset=utf8mb4&multiStatements=true
