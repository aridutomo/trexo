# Copy to .env.production and replace <MYSQL_ROOT_PASSWORD> with the real value.
# Targets the shared mysql-server container's PRODUCTION database (trexo).
# switch-db.sh then copies .env.production -> .env.local for `go run`.
GO_ENV=production
RUN_MIGRATIONS=true
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
DSN=root:<MYSQL_ROOT_PASSWORD>@tcp(127.0.0.1:3306)/trexo?parseTime=true&loc=UTC&charset=utf8mb4&multiStatements=true
