# Copy to frontend/.env.production and replace <MYSQL_ROOT_PASSWORD>.
# Targets the shared mysql-server container's PRODUCTION database (trexo).
# switch-env.sh then copies frontend/.env.production -> frontend/.env.local.
#
# DATABASE_URL MUST match the Go backend's DSN target (shared `session` table).
DATABASE_URL=mysql://root:<MYSQL_ROOT_PASSWORD>@127.0.0.1:3306/trexo
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it STABLE across restarts so existing sessions stay valid.
BETTER_AUTH_SECRET=<random-32-byte-base64-string>
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=production
GO_API_URL=http://localhost:8080
GO_API_KEY=
