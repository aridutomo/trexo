# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# ----------------------------------------------------------------------------
# better-auth (Next.js server) — connects to the shared MySQL database DIRECTLY
# (mysql2). The Golang backend reads the same DB's `session` table.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode the password if it contains special chars (#, @, :, /, space, ...).
DATABASE_URL=mysql://trexo:trexo-password@127.0.0.1:3306/trexo

# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: keep this secret stable across restarts so existing sessions stay valid.
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-base64-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Environment label shown in the web UI. "staging" renders a red "stg" badge
# (src/components/layout/EnvBadge.tsx); anything else (e.g. "production") hides
# it. switch-env.sh sets this per target DB.
NEXT_PUBLIC_APP_ENV=production

# ----------------------------------------------------------------------------
# Golang backend. The Next.js BFF proxy (src/app/api/v1/[...path]) forwards
# browser requests here with an X-Session-Token header. Local dev points at the
# Go server; production points at your TLS-terminated VPS URL.
GO_API_URL=http://localhost:8080

# Optional: shared secret the BFF sends as X-Api-Key. Must match BFF_API_KEYS in
# the backend's .env. Leave empty to disable the check.
GO_API_KEY=
