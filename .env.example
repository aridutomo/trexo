# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# ----------------------------------------------------------------------------
# better-auth (Next.js server) — connects to Supabase Postgres DIRECTLY (pg).
# Get this from Supabase → Settings → Database → Connection string →
# "Transaction pooler" (port 6543). Replace [PASSWORD] and [REGION].
# The pgbouncer=true param + prepare:false (in src/lib/auth.ts) are required
# for the transaction pooler.
# IMPORTANT: if your DB password contains URL-special chars (#, @, :, /, !, ?,
# space, etc.) you MUST URL-encode them here, or `pg` mis-parses the connection
# string (it treats the username as the host) and every auth call fails with a
# misleading error. e.g. password "##Abc!!##" -> "%23%23Abc%21%21%23%23".
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-base64-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# GAS bridge (Next.js → Google Apps Script). Fill in AFTER you deploy the
# GAS Web App in Phase 3.
# GAS_API_URL = the Web App URL (.../exec). GAS_API_KEY = shared secret that
# must also be added to GAS Script Properties under GAS_API_KEYS.
GAS_API_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOY_ID/exec
GAS_API_KEY=replace-with-a-long-random-shared-secret
